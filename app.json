  "drivers": [
    {
      "name": {
        "en": "SmartEVSE",
        "nl": "SmartEVSE"
      },
      "class": "evcharger",
      "energy": {
        "evCharger": true,
        "meterPowerImportedCapability": "meter_power"
      },
      "capabilities": [
        "evcharger_charging_state",
        "charging_status_text",
        "evcharger_charging",
        "measure_power",
        "meter_power",
        "charger_mode",
        "charge_phase_mode",
        "override_current_a",
        "override_reset",
